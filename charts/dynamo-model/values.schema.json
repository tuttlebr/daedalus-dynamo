{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["model", "modelCache", "redis", "frontend", "worker", "planner", "availability"],
  "properties": {
    "model": {
      "type": "object",
      "required": ["name", "id", "image", "imagePullPolicy", "backendFramework", "deploymentMode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "id": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "$ref": "#/definitions/imagePullPolicy" },
        "backendFramework": { "type": "string", "enum": ["vllm", "sglang", "trtllm"] },
        "deploymentMode": { "type": "string", "enum": ["direct", "dgdr"] },
        "envFromSecret": { "type": "string", "minLength": 1 },
        "runtimeVersionOverride": { "type": "string", "pattern": "^$|^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "buildDockerfile": { "type": "string", "minLength": 1 },
        "buildContext": { "type": "string", "minLength": 1 },
        "buildPlatform": { "type": "string", "enum": ["linux/amd64", "linux/arm64"] }
      }
    },
    "planner": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "$ref": "#/definitions/imagePullPolicy" },
        "maxGpuBudget": { "type": "integer", "minimum": 1 },
        "minEndpoint": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "dgdr": {
          "type": "object",
          "required": ["workload", "hardware"],
          "properties": {
            "workload": {
              "type": "object",
              "required": ["isl", "osl", "concurrency"],
              "properties": {
                "isl": { "type": "integer", "minimum": 1 },
                "osl": { "type": "integer", "minimum": 1 },
                "concurrency": { "type": "integer", "minimum": 1, "maximum": 3 }
              }
            },
            "hardware": {
              "type": "object",
              "required": ["gpuSku", "totalGpus", "numGpusPerNode", "vramMb"],
              "properties": {
                "gpuSku": { "type": "string", "minLength": 1 },
                "totalGpus": { "type": "integer", "minimum": 1 },
                "numGpusPerNode": { "type": "integer", "minimum": 1 },
                "vramMb": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "workerNamespaceCompat": { "type": "string", "enum": ["legacy", "hashed", "off"] },
        "compatHook": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "waitSeconds": { "type": "integer", "minimum": 0 },
            "restartPlanner": { "type": "boolean" }
          }
        }
      }
    },
    "modelexpress": {
      "type": "object",
      "properties": {
        "runtimeConfigMap": { "type": "string", "maxLength": 253 },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "imagePullPolicy": { "$ref": "#/definitions/imagePullPolicy" },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "resetRegistryOnStart": { "type": "boolean" },
        "waitForCacheReady": { "type": "boolean" }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "imagePullPolicy": { "$ref": "#/definitions/imagePullPolicy" },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "podDisruptionBudget": {
          "type": "object",
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "livenessFailureThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 6,
          "description": "Consecutive failed worker liveness probes before restart; probes run every 10 seconds."
        },
        "nodeGpuMemoryGt": {
          "$ref": "#/definitions/gpuMemoryBoundary"
        },
        "nodeGpuMemoryLt": {
          "$ref": "#/definitions/gpuMemoryBoundary"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cpuRequest": { "type": "string", "minLength": 1 },
        "cpuLimit": { "type": "string" },
        "memoryRequest": { "type": "string" },
        "memoryLimit": { "type": "string" },
        "sharedMemorySize": { "$ref": "#/definitions/quantity" },
        "workingDir": { "type": "string" },
        "scalingAdapter": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "startupProbe": {
          "type": "object",
          "required": ["path", "periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "securityContext": { "type": "object" },
        "applyVllmModelOptLmHeadPatch": {
          "type": "boolean"
        },
        "customJinjaTemplate": {
          "type": "object",
          "required": ["enabled", "sourceFile", "mountPath"],
          "properties": {
            "enabled": { "type": "boolean" },
            "sourceFile": { "type": "string" },
            "mountPath": { "type": "string" }
          }
        },
        "nofileLimit": {
          "type": "string",
          "pattern": "^[1-9][0-9]{4,}$"
        },
        "vllmOptions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": ["string", "number", "boolean", "object", "null"] }
        },
        "vllmArgs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trtllm": {
          "type": "object",
          "required": ["engineConfig", "args"],
          "properties": {
            "engineConfig": { "type": "object" },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "replicas": { "type": "integer", "minimum": 1 },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "nofileLimit": {
          "type": "string",
          "pattern": "^[1-9][0-9]{4,}$"
        }
      }
    },
    "availability": {
      "type": "object",
      "required": ["podDisruptionBudgets"],
      "properties": {
        "podDisruptionBudgets": {
          "type": "object",
          "required": ["enabled", "frontendMinAvailable", "workerMinAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "frontendMinAvailable": { "type": "integer", "minimum": 1 },
            "workerMinAvailable": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "imagePullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "quantity": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number", "minimum": 0 }
      ]
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/quantity" }
    },
    "resourceRequirements": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      }
    },
    "gpuMemoryBoundary": {
      "description": "A GPU memory boundary in MiB; an empty string disables the boundary.",
      "oneOf": [
        { "type": "string", "pattern": "^(|0|[1-9][0-9]*)$" },
        { "type": "integer", "minimum": 0 }
      ]
    }
  }
}
